{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "sdk:build": "npm --prefix sdk install && npm --prefix sdk run build",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "provision:tenant": "tsx src/scripts/provision-tenant.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.3",
    "bullmq": "^5.41.9",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.5.1",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.19.0",
    "testcontainers": "^11.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
