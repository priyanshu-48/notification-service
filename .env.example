DATABASE_URL=postgres://notifications:notifications@localhost:5433/notifications
HOST=0.0.0.0
PORT=3000
REDIS_URL=redis://localhost:6379
# Leave EMAIL_PROVIDER unset (or set it to mock) for the safe mock channel.
EMAIL_PROVIDER=mock
# Resend is enabled only when EMAIL_PROVIDER=resend and both values are configured.
RESEND_API_KEY=
EMAIL_FROM=
# HMAC secret for end-user WebSocket tokens (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_TOKEN_SECRET=dev-only-change-me-dev-only-change-me
# Jobs processed in parallel per worker, and Postgres connections per process.
WORKER_CONCURRENCY=10
DB_POOL_MAX=10
# Set RUN_WORKER=true to run the worker inside the API process (single-process hosting).
RUN_WORKER=false
# If set, /metrics requires `Authorization: Bearer <token>`.
METRICS_TOKEN=
# Per-tenant token bucket: sustained requests per minute and burst size.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=100
